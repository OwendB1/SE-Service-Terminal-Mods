<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>6</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VRage">
      <HintPath>$(SpaceEngineersDir)/Bin64/VRage.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VRage.Game">
      <HintPath>$(SpaceEngineersDir)/Bin64/VRage.Game.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VRage.Library">
      <HintPath>$(SpaceEngineersDir)/Bin64/VRage.Library.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VRage.Math">
      <HintPath>$(SpaceEngineersDir)/Bin64/VRage.Math.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="VRage.Render">
      <HintPath>$(SpaceEngineersDir)/Bin64/VRage.Render.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
